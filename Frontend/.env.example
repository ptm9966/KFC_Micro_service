# ========================================
# API ENDPOINTS - App Gateway Routing
# ========================================
# These variables point to API endpoints that App Gateway routes
# to the appropriate microservices based on paths

# For local development (direct microservice access)
REACT_APP_CART_SERVICE_URL=http://localhost:8080
REACT_APP_ORDERS_URL=http://localhost:8081
REACT_APP_USERS_URL=http://localhost:8082
REACT_APP_PRODUCTS_URL=http://localhost:8083

# For production with App Gateway (replace yourdomain.com)
# REACT_APP_CART_SERVICE_URL=https://yourdomain.com/api/cart
# REACT_APP_ORDERS_URL=https://yourdomain.com/api/orders
# REACT_APP_USERS_URL=https://yourdomain.com/api/users
# REACT_APP_PRODUCTS_URL=https://yourdomain.com/api/products

# Environment
REACT_APP_ENV=production

# API Timeout (in milliseconds)
REACT_APP_API_TIMEOUT=30000
