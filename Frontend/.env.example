# ========================================
# NGINX REVERSE PROXY CONFIGURATION
# ========================================
# These variables configure the nginx reverse proxy to route requests
# to the appropriate backend microservices

# Cart Microservice URL (used by nginx upstream)
# Local development: cart-service:8080 (Docker network)
# Production: your-cart-service-host:port
CART_SERVICE_URL=cart-service:8080

# Orders Microservice URL (used by nginx upstream)
# Local development: orders-service:8081 (Docker network)
# Production: your-orders-service-host:port
ORDERS_SERVICE_URL=orders-service:8081

# Products Microservice URL (used by nginx upstream)
# Local development: products-service:8082 (Docker network)
# Production: your-products-service-host:port
PRODUCTS_SERVICE_URL=products-service:8082

# User/Auth Microservice URL (used by nginx upstream)
# Local development: users-service:8083 (Docker network)
# Production: your-user-service-host:port
USER_SERVICE_URL=users-service:8083

# ========================================
# REACT APPLICATION ENVIRONMENT VARIABLES
# ========================================
# These are baked into the static build and used by React frontend
# for client-side API calls through the nginx proxy

# Cart service API URL (proxied through /api/cart)
REACT_APP_CART_SERVICE_URL=http://localhost/api/cart

# Orders service API URL (proxied through /api/orders)
REACT_APP_ORDERS_URL=http://localhost/api/orders

# Users service API URL (proxied through /api/users)
REACT_APP_USERS_URL=http://localhost/api/users

# Products service API URL (proxied through /api/products)
REACT_APP_PRODUCTS_URL=http://localhost/api/products

# Application Environment
REACT_APP_ENV=production

# API Timeout (in milliseconds)
REACT_APP_API_TIMEOUT=30000
